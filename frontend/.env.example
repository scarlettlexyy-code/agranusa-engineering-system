# URL Deployment Google Apps Script Web App Anda
# Dapatkan URL ini dari: Extensions > Apps Script > Deploy > Manage Deployments > Web App URL
GAS_API_URL=https://script.google.com/macros/s/AKfycbxYOUR_DEPLOYMENT_ID/exec

# Untuk pengujian frontend langsung (Vite dev)
VITE_GAS_API_URL=https://script.google.com/macros/s/AKfycbxYOUR_DEPLOYMENT_ID/exec
